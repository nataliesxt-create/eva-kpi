# Eva KPI Agent — Environment Variables
# Copy this to .env and fill in your values. Never commit .env to git.

# ── Slack ─────────────────────────────────────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-your-bot-token-here
SLACK_APP_TOKEN=xapp-your-app-level-token-here   # Required for Socket Mode
SLACK_SIGNING_SECRET=your-signing-secret-here
SLACK_EVA_KPI_CHANNEL_ID=C0123456789             # ID of #eva-kpi channel

# ── HubSpot ───────────────────────────────────────────────────────────────────
HUBSPOT_PRIVATE_APP_TOKEN=pat-na1-your-token-here

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-key-here

# ── Google Sheets ─────────────────────────────────────────────────────────────
# Either a file path to the service account JSON:
GOOGLE_SHEETS_CREDENTIALS=/path/to/service-account.json
# Or paste the raw JSON string (escape quotes in shell):
# GOOGLE_SHEETS_CREDENTIALS={"type":"service_account",...}

EVA_KPI_SETTINGS_SHEET_ID=your-google-sheet-id-here
EVA_KPI_SETTINGS_SHEET_NAME=Eva KPI Settings    # Default; change only if renamed
